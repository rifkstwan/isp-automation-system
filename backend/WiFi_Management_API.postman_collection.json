{
	"info": {
		"_postman_id": "wifi-cv-citra-mandiri-api",
		"name": "WiFi Management — CV Citra Mandiri API",
		"description": "Koleksi API lengkap untuk Sistem Manajemen WiFi CV Citra Mandiri.\n\nBase URL: http://localhost:8000/api\n\nAutentikasi: Bearer Token (Laravel Sanctum)\n\nPetunjuk:\n1. Jalankan Register atau Login terlebih dahulu\n2. Copy token dari response\n3. Set token di variabel collection {{auth_token}}",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api"
		},
		{
			"key": "auth_token",
			"value": ""
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{auth_token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "01. Autentikasi",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"phone\": \"081234567890\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\"\n}"
						},
						"url": { "raw": "{{base_url}}/register" }
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('auth_token', jsonData.token);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@citramandiri.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": { "raw": "{{base_url}}/login" }
					}
				},
				{
					"name": "Me (Info User)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": { "raw": "{{base_url}}/me" }
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": { "raw": "{{base_url}}/logout" }
					}
				}
			]
		},
