# ============================================================
#  .env.docker.example — TEMPLATE (aman untuk di-commit)
#  Cara pakai: cp .env.docker.example .env.docker
#  Lalu isi nilainya (minta ke team lead)
# ============================================================

# Laravel App Key (generate dengan: php artisan key:generate)
APP_KEY=base64:your_app_key_here

# Database
POSTGRES_PASSWORD=your_db_password_here
DB_PASSWORD=your_db_password_here

# Email (Gmail - gunakan App Password dari myaccount.google.com)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM_ADDRESS=your_email@gmail.com

# Midtrans Payment Gateway (dari dashboard.midtrans.com)
MIDTRANS_MERCHANT_ID=your_merchant_id
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxx

# Frontend
VITE_MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxx
