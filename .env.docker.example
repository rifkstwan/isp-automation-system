# ============================================================
#  .env.docker.example — Template environment untuk Docker
#  Salin file ini: cp .env.docker.example .env.docker
#  Isi dengan nilai yang sesuai (minta ke team lead)
# ============================================================

# Database
DB_PASSWORD=your_db_password_here

# Email (Gmail - gunakan App Password, bukan password biasa)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM_ADDRESS=your_email@gmail.com

# Midtrans Payment Gateway (dapatkan dari dashboard.midtrans.com)
MIDTRANS_MERCHANT_ID=your_merchant_id
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxx
